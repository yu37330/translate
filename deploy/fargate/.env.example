# ローカルPoC用。ECS本番ではSecrets Managerから渡す（Gitには秘密情報を置かない）
APP_ACCESS_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# DockerではMODEL_SIZEに応じてASR_MODEL_PATHが設定される
ASR_CPU_THREADS=4

# 空欄ならBedrockは無効（Whisperのみ）。有効化する場合は承認済みモデルIDまたは推論プロファイルIDを指定
BEDROCK_MODEL_ID=
BEDROCK_REGION=ap-northeast-1

# streaming ASR: tune these against real meeting audio and CER / latency
ASR_BEAM_SIZE=3
ASR_SPEECH_THRESHOLD=0.0006
ASR_VOCAB_PROMPT=
ASR_PREVIOUS_CONTEXT_CHARS=80
ASR_MIN_INTERIM_SEC=4
ASR_INTERIM_INTERVAL_SEC=4
ASR_MAX_UTTERANCE_SEC=12

# Second-stage quality tuning: no extra external services
ASR_END_SILENCE_SEC=0.8
ASR_PREROLL_SEC=0.3
ASR_HOTWORDS=
